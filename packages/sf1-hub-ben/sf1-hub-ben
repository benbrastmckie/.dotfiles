def _env_file_value(name):
    """One KEY=VALUE from the env file (the CLI runs outside systemd's EnvironmentFile). Never printed."""
    try:
        for line in open(ENVF):
            k, _, v = line.strip().partition('=')
            if k == name: return v.strip().strip('"').strip("'")
    except OSError: pass
    return None


