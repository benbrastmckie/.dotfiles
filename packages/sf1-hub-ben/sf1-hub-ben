def phrase(person, repo_name):
    return 'I, %s, consent to the shared SF-1 hub runner on %s' % (person, repo_name)


def say(*a):
    print('[sf1-hub-ben]', *a, file=sys.stderr)


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as fh:
        for b in iter(lambda: fh.read(65536), b''): h.update(b)
    return h.hexdigest()


def atomic_json(path, obj, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp.%d' % os.getpid()
    with open(tmp, 'w') as fh: json.dump(obj, fh, indent=1, sort_keys=True)
    os.chmod(tmp, mode); os.replace(tmp, path)


def load_manifest():
    try:
        with open(MANIFEST) as fh: return json.load(fh)
    except (OSError, ValueError):
        return {'version': VERSION, 'created': [], 'backups': {}, 'checkouts': {}}


def save_manifest(m): atomic_json(MANIFEST, m)


def record(m, path):
    if path not in m['created']: m['created'].append(path)


def in_nix_store(path):
    """True when a path, or anything it resolves through, is in the read-only Nix store (home-manager links)."""
    try: return os.path.realpath(path).startswith('/nix/store/')
    except OSError: return False


def git(args, cwd):
    r = subprocess.run(['git'] + args, cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0: raise RuntimeError('git %s: %s' % (' '.join(args), r.stderr.strip()[:200]))
    return r.stdout.strip()


def checkout_info(co):
    co = os.path.realpath(os.path.expanduser(co))
    top = git(['rev-parse', '--show-toplevel'], co)
    gd = git(['rev-parse', '--git-common-dir'], top)
    gd = gd if os.path.isabs(gd) else os.path.realpath(os.path.join(top, gd))
    return top, gd, os.path.join(gd, 'oliver-ben-guard')


def is_human_terminal():
    """A human step needs a real terminal on stdin AND stdout. Claude Code's Bash tool and `claude -p` have neither,
    so an agent cannot complete one (gotchas 2026-09-29: a `!` line or agent Bash call has no tty)."""
    if os.environ.get('CLAUDECODE') or os.environ.get('CLAUDE_CODE_ENTRYPOINT') or os.environ.get('SF1_TASK_ID'):
        return False
    return os.isatty(0) and os.isatty(1)


def human_only(what):
    if not is_human_terminal():
        say('%s is a human step: run it yourself in a real terminal (not from Claude Code, not from a script).' % what)
        sys.exit(EX_REFUSE)


# ── token ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
def write_env_line(name, value):
    lines = []
    try: lines = [l.rstrip('\n') for l in open(ENVF)]
    except OSError: pass
    lines = [l for l in lines if l.partition('=')[0].strip() != name] + ['%s=%s' % (name, value)]
    os.makedirs(CFG, exist_ok=True)
    tmp = ENVF + '.tmp.%d' % os.getpid()
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as fh: fh.write('\n'.join(lines) + '\n')
    os.chmod(tmp, 0o600); os.replace(tmp, ENVF)


def parse_token(raw):
    raw = (raw or '').strip()
    m = re.search(r'[?&]token=([^&#\s]+)', raw)
    t = m.group(1) if m else raw
    if t.startswith(('hub_', 'mtk_', 'rk_')): return None, 'that is a scoped key, not your own Sapience token (use the private link)'
    if not TOKEN_RE.match(t): return None, 'that does not look like a Sapience token or private link'
    return t, ''


def store_token(t):
    os.makedirs(CFG, exist_ok=True)
    tmp = TOKF + '.tmp.%d' % os.getpid()
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as fh: fh.write(t + '\n')
    os.chmod(tmp, 0o600); os.replace(tmp, TOKF)
    write_env_line('SAPIENCE_TOKEN', t)


def read_hidden(prompt):
    """One line from the terminal with echo off. TCSANOW, not getpass's TCSAFLUSH, so a paste that lands before the
    prompt is not thrown away."""
    import termios
    sys.stderr.write(prompt); sys.stderr.flush()
    fd = sys.stdin.fileno(); old = termios.tcgetattr(fd); new = termios.tcgetattr(fd); new[3] &= ~termios.ECHO
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        line = sys.stdin.readline()
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old); sys.stderr.write('\n')
    return line


def cmd_token():
    """HUMAN ONLY: paste your private link (or the bare token); nothing is echoed or printed."""
    human_only('token')
    t, why = parse_token(read_hidden('Paste your Sapience private link (Settings > Sign in on another device > copy my private link). Not shown: '))
    if not t: say(why); return 1
    store_token(t)
    say('saved (mode 600): %s and SAPIENCE_TOKEN in %s. Nothing printed.' % (TOKF, ENVF))
    return 0


def guard_home(token):
    """A throwaway HOME holding .sapience/config.json, ONLY for the vendored install.sh's first `guard refresh` (it runs
    before key_file can be set in the config it writes). Real git config stays visible. Removed right after."""
    import tempfile
    d = tempfile.mkdtemp(prefix='gh-', dir=STATE)
    os.makedirs(os.path.join(d, '.sapience'), mode=0o700)
    fd = os.open(os.path.join(d, '.sapience', 'config.json'), os.O_WRONLY | os.O_CREAT, 0o600)
    with os.fdopen(fd, 'w') as fh: json.dump({'token': token}, fh)
    return d


# ── consent ────────────────────────────────────────────────────────────────────────────────────────────────────────────────
def consent_path(sd, person=PERSON): return os.path.join(sd, 'CONSENT-%s.json' % person)


def check_consent(co, person=PERSON):
    """-> (ok, why). The marker must exist, be a regular file owned by this uid (not a link), and carry the exact
    phrase for THIS repo. The installer never writes it; only `consent` (tty-gated) or Ben by hand."""
    try: top, gd, sd = checkout_info(co)
    except RuntimeError as e: return False, 'not a git checkout: %s' % e
    p = consent_path(sd, person)
    if not os.path.lexists(p): return False, 'no consent marker at %s' % p
    if os.path.islink(p): return False, 'consent marker is a symlink (refused): %s' % p
    st = os.stat(p)
    if st.st_uid != os.getuid(): return False, 'consent marker not owned by you: %s' % p
    try:
        with open(p) as fh: c = json.load(fh)
    except (OSError, ValueError) as e: return False, 'consent marker unreadable: %s' % e
    name = os.path.basename(top)
    if c.get('phrase') != phrase(person, name): return False, 'consent phrase does not match this repo (%s)' % name
    if c.get('repo_toplevel') != top: return False, 'consent marker names another checkout (%s)' % c.get('repo_toplevel')
    if c.get('withdrawn'): return False, 'consent withdrawn at %s' % c.get('withdrawn')
    return True, 'consented %s by %s' % (c.get('created_at'), person)


def cmd_consent(co):
    human_only('consent')
    top, gd, sd = checkout_info(co)
    if not os.path.isfile(os.path.join(sd, 'config.json')):
