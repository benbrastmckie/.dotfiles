# Nix build outputs
result
result-*

# Temporary files
*.swp
*.swo
*~
\#*\#
.\#*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories
.vscode/
.idea/
*.sublime-*

# Direnv
.direnv/
.envrc

# Secrets
config/rclone.conf
config/zuliprc

# Agent system directories — untracked and scrubbed from git history 2026-07-02.
# Kept on disk (gitignored), not version-controlled here.
/.claude/
/.opencode/
/opencode.json

# Extension picker state — generated from whichever extensions are loaded.
/.claude-extensions.json

# Agent system runtime logs — rewritten every session.
/.agent-logs/

# Task-system scratch space — directory must persist (skill-base.sh atomic-write dependency)
specs/tmp/*
!specs/tmp/.gitkeep

# Task-system event store — machine-local append-only telemetry (read by /distill --dream)
# plus its advisory lock.
specs/events.jsonl
specs/.events.lock

# Orchestrator per-cycle runtime state — ephemeral, machine-local, never committed.
# See .claude/context/standards/orchestrator-runtime-files.md for the two-class policy.
#
# These are read back with no freshness check: skill-orchestrate trusts any syntactically valid
# .orchestrator-loop-guard it finds, comparing neither session_id nor mtime against the current
# dispatch. A git-restored copy therefore resumes a WRONG cycle_count/infra_failures pair
# silently, which is exactly the hazard this coverage prevents. The handoff files carry the same
# risk in the other direction: a restored stale handoff reports a previous cycle's status and
# phase counts as if they were the current dispatch's.
specs/**/.orchestrator-loop-guard
specs/**/.drift-inspection.json
specs/**/.stray-handoff-*.json
specs/.return-meta-multi.json
specs/.orchestrator-multi-state.json

# Per-task advisory lock directories (task-lock.sh).
specs/**/.lock/
/packages/sapience-flake/.agent-logs
